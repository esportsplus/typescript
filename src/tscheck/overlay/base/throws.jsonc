// Base throws-channel overlay. Top-level keys are lib sections; each section
// maps an overlay key (see load.ts overlayKey) to a throws entry:
//   { "throws": ["SyntaxError"] }   - the error types the leaf may throw
//   { "throwsFromCallbacks": [0] }  - inherits whatever the arg at that index throws
//   { "throws": [] }                - modeled as non-throwing (so it is not logged)
// This whole file is the "throws" channel section (channel is implicit here).
{
  "lib.es5": {
    "JSON.parse": { "throws": ["SyntaxError"] },
    "JSON.stringify": { "throws": [] },

    "decodeURI": { "throws": ["URIError"] },
    "decodeURIComponent": { "throws": ["URIError"] },
    "encodeURI": { "throws": ["URIError"] },
    "encodeURIComponent": { "throws": ["URIError"] },

    "RegExp": { "throws": ["SyntaxError"] },

    "Number.parseInt": { "throws": [] },
    "Number.parseFloat": { "throws": [] },
    "parseInt": { "throws": [] },
    "parseFloat": { "throws": [] },

    "Array#map": { "throwsFromCallbacks": [0] },
    "Array#forEach": { "throwsFromCallbacks": [0] },
    "Array#filter": { "throwsFromCallbacks": [0] },
    "Array#reduce": { "throwsFromCallbacks": [0] },
    "Array#reduceRight": { "throwsFromCallbacks": [0] },
    "Array#some": { "throwsFromCallbacks": [0] },
    "Array#every": { "throwsFromCallbacks": [0] },
    "Array#find": { "throwsFromCallbacks": [0] },
    "Array#findIndex": { "throwsFromCallbacks": [0] },
    "Array#sort": { "throwsFromCallbacks": [0] }
  },

  "lib.es2015": {
    "Map#forEach": { "throwsFromCallbacks": [0] },
    "Set#forEach": { "throwsFromCallbacks": [0] }
  },

  "lib.es2019": {
    "Array#flatMap": { "throwsFromCallbacks": [0] }
  },

  "lib.es2020": {
    "BigInt": { "throws": ["RangeError", "SyntaxError", "TypeError"] }
  },

  "lib.dom": {
    "URL": { "throws": ["TypeError"] },
    "URLSearchParams": { "throws": ["TypeError"] },
    "structuredClone": { "throws": ["DataCloneError"] }
  }
}
