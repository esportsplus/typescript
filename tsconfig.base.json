{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "declaration": false,
        "esModuleInterop": true,
        "isolatedModules": true,
        "lib": [
            "es2024"
        ],
        "module": "esnext",
        "moduleDetection": "force",
        "moduleResolution": "bundler",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "outDir": "${configDir}/build",
        "paths": {
            "~/*": [
                "${configDir}/src/*"
            ],
            "~/storage/*": [
                "${configDir}/storage/*"
            ]
        },
        "plugins": [
            {
                "name": "ts-probe",
                // Editor squiggle color; "warn" opts down. CLI/build ignore this.
                "severity": "error",
                // Fail the tsc/build run when there are findings.
                "failOnFindings": true,
                "channels": {
                    "exceptions": {
                        "enabled": true,
                        "report": "consumers",
                        // Flag `throw`s inside `catch` that drop the caught error's cause.
                        "errorCause": true
                    }
                },
                // Model third-party throw behavior: "node", "express".
                "presets": ["node"]
            }
        ],
        "removeComments": true,
        "resolveJsonModule": true,
        "rootDir": "${configDir}/src",
        "skipLibCheck": true,
        "strict": true,
        "target": "es2024"
    },
    "include": [
        "${configDir}/src/**/*"
    ],
    "tsc-alias": {
        "resolveFullPaths": true
    }
}