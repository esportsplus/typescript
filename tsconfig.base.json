{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "declaration": false,
        "esModuleInterop": true,
        "isolatedModules": true,
        "lib": [
            "es2024"
        ],
        "module": "esnext",
        "moduleDetection": "force",
        "moduleResolution": "bundler",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "outDir": "${configDir}/build",
        "paths": {
            "~/*": [
                "${configDir}/src/*"
            ],
            "~/storage/*": [
                "${configDir}/storage/*"
            ]
        },
        "removeComments": true,
        "resolveJsonModule": true,
        "rootDir": "${configDir}/src",
        "skipLibCheck": true,
        "strict": true,
        "target": "es2024"
    },
    "include": [
        "${configDir}/src/**/*"
    ],
    "tsc-alias": {
        "resolveFullPaths": true
    },
    // Channel names at the root; each carries its own "severity" ("error" reports
    // and fails the build, "warn" reports only, "off"/absent skips). Platform
    // effect models are built in — no presets/overlays to configure.
    "tsc-probe": {
        "exceptions": {
            "severity": "error",
            "report": "cross-module",
            // Flag `throw`s inside `catch` that drop the caught error's cause.
            "errorCause": true
        },
        "resources": {
            "severity": "error",
            // Untracked escape handling: "optimist" assumes transfer (silent),
            // "pessimist" reports it.
            "dispatch": "optimist"
        },
        "async": {
            "severity": "warn",
            // Unbounded Promise.all-style fan-out; severity governs the level.
            "fanOut": true
        }
    }
}