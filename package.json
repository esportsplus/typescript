{
    "author": "ICJR",
    "bin": {
        "esportsplus-tsc": "./bin/tsc",
        "esportsplus-tsc-alias": "./bin/tsc-alias",
        "esportsplus-tsc-lsp": "./bin/tsc-lsp",
        "tsc": "./bin/tsc",
        "tsc-alias": "./bin/tsc-alias"
    },
    "dependencies": {
        "@esportsplus/cli-passthrough": "^0.0.15",
        "@esportsplus/utilities": "^0.28.0",
        "@types/node": "^26.4.1",
        "tsc-alias": "^1.9.4",
        "typescript": "7.0.2",
        "vscode-languageserver": "^10.1.1",
        "vscode-languageserver-textdocument": "^1.0.14"
    },
    "devDependencies": {
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "exports": {
        "./package.json": "./package.json",
        "./tsconfig.browser.dev.json": "./tsconfig.browser.dev.json",
        "./tsconfig.browser.json": "./tsconfig.browser.json",
        "./tsconfig.node.dev.json": "./tsconfig.node.dev.json",
        "./tsconfig.node.json": "./tsconfig.node.json",
        "./tsconfig.package.dev.json": "./tsconfig.package.dev.json",
        "./tsconfig.package.json": "./tsconfig.package.json",
        "./compiler": {
            "types": "./build/compiler/index.d.ts",
            "default": "./build/compiler/index.js"
        },
        "./lsp": {
            "types": "./build/lsp/index.d.ts",
            "default": "./build/lsp/index.js"
        },
        ".": {
            "types": "./build/index.d.ts",
            "default": "./build/index.js"
        }
    },
    "files": [
        "bin",
        "build",
        "tsconfig.base.json",
        "tsconfig.browser.dev.json",
        "tsconfig.browser.json",
        "tsconfig.node.dev.json",
        "tsconfig.node.json",
        "tsconfig.package.dev.json",
        "tsconfig.package.json"
    ],
    "main": "build/index.js",
    "name": "@esportsplus/typescript",
    "overrides": {
        "postcss": "8.5.15"
    },
    "private": false,
    "repository": {
        "type": "git",
        "url": "https://github.com/esportsplus/typescript"
    },
    "scripts": {
        "agent:bench": "pnpm bench:run",
        "agent:build": "pnpm build",
        "agent:test": "pnpm typecheck && pnpm test",
        "bench:run": "vitest bench --run",
        "build": "tsc -p tsconfig.package.json && tsc-alias -p tsconfig.package.json && node -e \"const fs=require('fs');fs.cpSync('src/guard/overlay','build/guard/overlay',{recursive:true,filter:(s)=>!/\\.[cm]?tsx?$/.test(s)})\"",
        "prepare": "pnpm build",
        "prepublishOnly": "pnpm build",
        "test": "vitest run",
        "typecheck": "tsc",
        "verify": "pnpm build && pnpm typecheck && pnpm test"
    },
    "type": "module",
    "types": "build/index.d.ts",
    "version": "0.33.7",
    "packageManager": "pnpm@11.10.0"
}
