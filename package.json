{
    "author": "ICJR",
    "bin": {
        "esportsplus-tsc": "./bin/tsc",
        "esportsplus-tsc-lsp": "./bin/tsc-lsp",
        "tsc": "./bin/tsc"
    },
    "dependencies": {
        "@types/node": "^26.6.6",
        "typescript": "7.1.0-beta",
        "vscode-languageserver": "^11.0.0",
        "vscode-languageserver-textdocument": "^1.0.16"
    },
    "devDependencies": {
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=26"
    },
    "exports": {
        "./package.json": "./package.json",
        "./tsconfig.browser.dev.json": "./tsconfig.browser.dev.json",
        "./tsconfig.browser.json": "./tsconfig.browser.json",
        "./tsconfig.node.dev.json": "./tsconfig.node.dev.json",
        "./tsconfig.node.json": "./tsconfig.node.json",
        "./tsconfig.package.dev.json": "./tsconfig.package.dev.json",
        "./tsconfig.package.json": "./tsconfig.package.json",
        "./oxlintrc.json": "./oxlintrc.json",
        "./compiler": {
            "types": "./build/compiler/index.d.ts",
            "default": "./build/compiler/index.js"
        },
        "./lsp": {
            "types": "./build/lsp/index.d.ts",
            "default": "./build/lsp/index.js"
        },
        ".": {
            "types": "./build/index.d.ts",
            "default": "./build/index.js"
        }
    },
    "files": [
        "bin",
        "build",
        "oxlintrc.json",
        "tsconfig.base.json",
        "tsconfig.browser.dev.json",
        "tsconfig.browser.json",
        "tsconfig.node.dev.json",
        "tsconfig.node.json",
        "tsconfig.package.dev.json",
        "tsconfig.package.json"
    ],
    "main": "build/index.js",
    "name": "@esportsplus/typescript",
    "packageManager": "pnpm@11.10.0",
    "private": false,
    "repository": {
        "type": "git",
        "url": "https://github.com/esportsplus/typescript"
    },
    "scripts": {
        "agent:bench": "pnpm bench:run",
        "agent:build": "pnpm build",
        "agent:test": "pnpm typecheck && pnpm test",
        "bench:run": "vitest bench --run",
        "build": "tsc -p tsconfig.package.json && node build/cli/specifiers.js tsconfig.package.json && node -e \"const fs=require('fs');fs.cpSync('src/guard/overlay','build/guard/overlay',{recursive:true,filter:(s)=>!/\\.[cm]?tsx?$/.test(s)})\"",
        "lint": "oxlint -c oxlintrc.json --type-aware --deny-warnings --ignore-pattern=\"test/**/fixtures/**\"",
        "prepare": "pnpm build",
        "prepublishOnly": "pnpm build",
        "test": "vitest run",
        "typecheck": "tsc",
        "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test"
    },
    "type": "module",
    "types": "build/index.d.ts",
    "version": "0.41.0"
}
